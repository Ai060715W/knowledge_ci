# Copy to .env; leave pilot fields empty until a real repository is selected.
KNOWLEDGE_CI_HOST=127.0.0.1
KNOWLEDGE_CI_PORT=8000
KNOWLEDGE_CI_LOG_LEVEL=info
KNOWLEDGE_CI_PILOT_REPOSITORY=
KNOWLEDGE_CI_PILOT_COMMIT=
KNOWLEDGE_CI_PILOT_LANGUAGE=vue-typescript
KNOWLEDGE_CI_PILOT_OWNER=
# T01 has no external model adapter. Future provider/budget are still to be selected.
KNOWLEDGE_CI_MODEL_PROVIDER=mock
KNOWLEDGE_CI_ALLOW_SOURCE_EGRESS=false
KNOWLEDGE_CI_MODEL_BUDGET_USD=0
